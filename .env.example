# Kisaan Suvidha 2.0 - Environment configuration
# Copy this file to .env and fill in your own values.
# NEVER commit real credentials to version control.

# Database
DB_HOST=localhost
DB_USER=kisaan_user
DB_PASSWORD=your_db_password_here
DB_NAME=kisaan_suvidha

# Flask
SECRET_KEY=your-random-secret-key-change-me
FLASK_ENV=development

# Twilio (used for OTP delivery on signup & forgot-password)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OTP security
OTP_PEPPER=your-random-otp-pepper-change-me

# Development OTP visibility (set to false in production)
# When true and FLASK_ENV=development, OTPs are printed to the terminal.
OTP_DEBUG=true
DEV_OTP_LOGGING=true

# Mistral AI (crop recommendation engine)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_1=mistral-small-latest
MISTRAL_MODEL_2=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Groq AI (alternative crop analysis)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq AI #2 (agricultural validation - replaces Gemini)
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_MODEL_2=llama-3.1-8b-instant
GROQ_BASE_URL_2=https://api.groq.com/openai/v1

# Groq AI #3 (crop guide - replaces Gemini parts 1 & 2)
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_MODEL_3=llama-3.1-8b-instant
GROQ_BASE_URL_3=https://api.groq.com/openai/v1

# OpenWeatherMap (real-time weather data)
OPENWEATHER_API_KEY=your_openweather_api_key_here
